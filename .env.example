# =============================================================================
# 双人对话播客自动生成系统 —— 环境变量模板
# 复制为 .env 后按实际环境填写；.env 不得入库（见 .gitignore）
# =============================================================================

# 服务
APP_HOST=0.0.0.0
APP_PORT=8000
# RSS enclosure 与订阅源对外使用的基址。
# 本地联调可用 http://<本机内网IP>:8000，生产必须为公网域名或对象存储地址。
PUBLIC_BASE_URL=http://192.168.1.100:8000

# 大模型（DeepSeek，OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk_your_deepseek_key_here     # 仅存于此文件，禁止入库/入日志/入前端
LLM_MODEL=deepseek-chat                   # 默认模型
# 备选模型：⚠️ deepseek-reasoner 在部分 Key 的网关上被静默映射为 flash（实测），
# 故改用 /models 明确列出的 deepseek-v4-pro，规避映射歧义。
# 纪律：凡涉及「用了哪个模型」的结论，一律读响应体 model 字段，不以请求参数为准。
LLM_REASONER_MODEL=deepseek-v4-pro
LLM_TIMEOUT=60                            # 常规主题超时
LLM_TIMEOUT_LONG=120                      # 长脚本（>=2000 字）超时
LLM_MAX_RETRY=2                           # 由 tenacity 控制（SDK 层设 max_retries=0）
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=4096

# CosyVoice（净可用 4.32 GB 硬约束）
# 主模型定稿依据（D2 实测，同文本同音色，计划书 2.3/2.5）：
#   CosyVoice2-0.5B     加载 12.5s 常驻 2442MB RTF 1.037 峰值 alloc 3513 / reserved 4024 → 双口径达标
#   Fun-CosyVoice3-0.5B 加载 14.9s 常驻 3310MB RTF 1.057 峰值 alloc 4338 / reserved 5306 → 双口径超限
# 因此默认定稿 CosyVoice2；CosyVoice3 记入 V2.0 候选（需 8GB+ 显存设备）。
TTS_MODEL=cosyvoice2
COSYVOICE_ROOT=CosyVoice
COSYVOICE_MODEL_DIR=pretrained_models/CosyVoice2-0.5B
COSYVOICE_FP16=true              # 强制 fp16，禁止 fp32
COSYVOICE_ONNX_DEVICE=cpu        # onnx 组件走 CPU（PATCH-VRAM-01），省 0.5~1.0 GB
# ⚠️ 键名**无** COSYVOICE_ 前缀（对应字段 max_chars_per_seg）。
# 旧写法 COSYVOICE_MAX_CHARS_PER_SEG 会被 pydantic 的 extra="ignore" **静默忽略**
# （实测：设 77 无效、设 MAX_CHARS_PER_SEG 有效）。详见《项目参数说明》。
MAX_CHARS_PER_SEG=40             # 净可用 4.32 GB 下的显存安全档（60 字会顶到门槛）
TTS_DEVICE=cuda:0
TTS_WARMUP=true                  # 启动时预热一次，避免首句耗时异常
TTS_EMPTY_CACHE_EACH_SEG=true    # 每句推理后清显存缓存
TTS_MAX_WORKERS=1                # 6 GB 下必须单并发
# ⚠️ 失效键：config.py 中无 tts_report_memory 字段，此行当前不生效（保留备查）
TTS_REPORT_MEMORY=true           # 启动/每任务打印显存峰值
# 显存门槛双口径（V1.4.0）：allocated 为主口径，reserved 为辅口径。
# 单写一个数字会造成口径歧义（reserved 天然比 allocated 高 400~500MB）。
TTS_VRAM_BUDGET_ALLOC_MB=3600
TTS_VRAM_BUDGET_RESERVED_MB=4200

# 生成收敛守卫（PATCH-GUARD-01）
# 上游 Qwen2LM.inference_wrapper 为 `for i in range(max_len)`，只在产出 stop token 时 break；
# 未收敛时会吐满 max_len 个 token，输出是被截断的残句，且峰值显存随序列长度抬升。
# 时长上限 = text_len × TTS_MAX_TOKEN_TEXT_RATIO ÷ TTS_TOKEN_FRAME_RATE
# （20 字中文句 text_len=20 → 400 token → 400/25 = 16.00 s，与实测吻合）。
# 输出时长 ≥ 上限 × TTS_GUARD_THRESHOLD 即判为未收敛 → 偏移种子重试。
TTS_CONVERGENCE_GUARD=true
TTS_TOKEN_FRAME_RATE=25           # CosyVoice2 语音 token 帧率（Hz），决定「秒/ token」
TTS_MAX_TOKEN_TEXT_RATIO=20       # 与上游 Qwen2LM.inference 默认值一致，勿单独下调
TTS_GUARD_THRESHOLD=0.97          # 判为未收敛的时长系数
TTS_GUARD_RETRY=2                 # 重试次数；重试会偏移随机种子（否则固定种子下必然复现残句）

# 随机种子固定（P2 决策①）
# 推理链路三处随机源都走 torch 全局 RNG：LLM 多项式采样、flow 先验噪声、HiFi-GAN 声码器噪声。
# 固定后「同 (文本,音色,语速,语气) → 同音频」，句级缓存语义自洽；种子已纳入缓存键。
# 填负数 = 关闭固定，回到非确定性采样（不建议：缓存与基线都会失去可比性）。
TTS_RANDOM_SEED=42
TTS_SEED_RETRY_STRIDE=1           # 守卫重试时种子偏移步长，避免原地重试复现同一残句

# 音色档案与说话人映射
# 脚本里的 speaker 是 A/B，音色档案 id 是 voice_a/voice_b，必须显式映射；
# voice_b 缺失时按 SPEAKER_FALLBACK_ENABLED 回退到 A（启动日志告警，不静默）。
VOICES_DIR=backend/voices
SPEAKER_A_VOICE=voice_a
SPEAKER_B_VOICE=voice_b
SPEAKER_FALLBACK_ENABLED=true
POLYPHONE_DICT=backend/dicts/polyphone.json

# 音频后期（D5）
AUDIO_SAMPLE_RATE=44100    # 后期统一采样率（合成阶段保持模型原生 16k/24k）
AUDIO_CHANNELS=1
AUDIO_LOUDNESS_I=-16       # 播客标准响度 -16 LUFS
AUDIO_TRUE_PEAK=-1.5       # 真峰上限 dBTP，留余量防 LAME 转码削波
AUDIO_LRA=11               # 响度范围
AUDIO_PAUSE_TURN_MS=500    # 话轮停顿（换人）
AUDIO_PAUSE_SENTENCE_MS=250 # 句间停顿（同一人）
AUDIO_FADE_MS=30           # 片头/片尾微淡化时长
AUDIO_MP3_BITRATE=128k
AUDIO_NORMALIZE=true       # false 则跳过两遍 loudnorm（省一次全片扫描，见 R13）
AUDIO_LOUDNESS_TOLERANCE=1.0 # 第二遍后实测响度与目标值的允差（LUFS），超出告警
INTRO_PATH=backend/assets/intro.mp3
OUTRO_PATH=backend/assets/outro.mp3
AUDIO_REQUIRE_INTRO=false  # true 时片头缺失即报错（默认跳过并告警）

# FFmpeg 定位（留空自动发现：PATH → winget 目录 → 常见安装路径）
# 要求 FFmpeg ≥ 9.0 且 loudnorm / libmp3lame 可用（计划书 1.4 P-8）
FFMPEG_BIN=
FFPROBE_BIN=
FFMPEG_TIMEOUT=600

# 内容与提示词（D4 脚本生成）
WORDS_PER_MINUTE=260       # 中文对谈语速，用于目标时长反推字数
PROMPTS_DIR=backend/prompts
SENSITIVE_DICT=backend/dicts/sensitive_words.txt
# 下列三项（每行字数上限 / 交替规则 / 字数容差）同时硬编码在系统提示词里，
# 服务启动时会做一致性自检，不一致即 fail-fast ——
# 避免「提示词说 40 字、校验器按别的阈值判」这类阈值脱节（同 PATCH-GUARD-02 一类缺陷）。
SCRIPT_MAX_CHARS_PER_LINE=40
SCRIPT_REQUIRE_ALTERNATING=true
SCRIPT_WORD_TOLERANCE=0.10
# 总字数配额是否判为硬性失败。默认 false —— D4 实测：模型每行长度稳定在 12~21 字符
# 且不随提示词变化，总字数系统性偏低（三轮提示词标定各 10/10 低于配额），
# 当作硬判据会让「可用率」恒为 0~70%。配额仍驱动纠错重试，达标率另行上报
# （ScriptGenResult.word_quota_ok）。需要按字数卡验收时置 true。
SCRIPT_WORD_QUOTA_ENFORCE=false
SCRIPT_CORRECTION_RETRY=2  # 结构校验失败后带错误信息纠错重试的次数
SCRIPT_SELF_CHECK=true     # 生成后追加一次 LLM 合规自检（计划书 R9）；失败仅告警不阻断

# 云端 TTS 兜底（P1 条件性实现）
# V1.4.0 已废除「实测 RTF > 1.5 即启兜底」的判据：RTF 是单点指标，会误判。
# 改为按端到端口径决策（1000 字）：≤9 min 推进 / 9~10 min 提高缓存命中 / >10 min 才启兜底。
# ⚠️ 以下整组为**失效键**：config.py 中不存在 tts_fallback_enabled / tts_fallback_base_url /
# tts_fallback_api_key / tts_fallback_voice_a / tts_fallback_voice_b / tts_e2e_warn_min
# 六个字段，故下列六行当前**全部不生效**（保留备查，勿据此判断兜底是否可用）。
# 现状：P1「云端 TTS 兜底」**未实现**。
TTS_FALLBACK_ENABLED=false
TTS_FALLBACK_BASE_URL=     # 云端 TTS 服务地址（注意：与 LLM 端点分离，勿填 DeepSeek）
TTS_FALLBACK_API_KEY=
TTS_FALLBACK_VOICE_A=
TTS_FALLBACK_VOICE_B=
TTS_E2E_WARN_MIN=10        # 端到端 1000 字耗时超过该分钟数即告警并评估兜底

# 存储与安全
DATA_DIR=./data
WORK_DIR=./data/work       # 任务中间产物，任务终态后清理
CACHE_DIR=./data/cache     # 句级缓存，跨任务复用，不受 30 天保留期约束
AUDIO_RETENTION_DAYS=30
JWT_SECRET=change_me_in_production
JWT_EXPIRE_MINUTES=1440
