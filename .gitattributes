# =============================================================================
# 换行符与二进制属性 —— 保证「另一台电脑 clone 下来字节一致」
# =============================================================================
# 背景：本机 core.autocrlf=input。若不显式声明，文本文件在 checkout 时会被
# 转成 CRLF，导致交付包内交付清单_MANIFEST.json 逐字节 sha256 对不上。
# 本文件把所有文本统一为 LF（仓库内与工作区一致），二进制一律不转换。
#
# 新克隆的机器跑 `git config core.autocrlf false`（或直接依赖本文件）即可复现。

# --- 默认：文本一律 LF ---
* text=auto eol=lf

# --- 明确二进制（绝不转换，绝不做 diff/merge 文本处理）---
*.mp3  binary
*.wav  binary
*.m4a  binary
*.pptx binary
*.docx binary
*.xlsx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.woff binary
*.woff2 binary

# --- Windows 批处理必须 CRLF，否则 cmd.exe 解析出错 ---
*.bat text eol=crlf
*.cmd text eol=crlf

# --- 特定的 Markdown 真源保留其原有换行（Linguist 语言统计也一并声明）---
*.md   text eol=lf

# --- 语言统计（避免仓库被统计成纯文档项目）---
*.py   linguist-language=Python
*.tsx  linguist-language=TypeScript
*.ts   linguist-language=TypeScript
*.slide linguist-language=HTML
