<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#F7F9FC', fontFamily: 'Source Han Sans SC, Noto Sans SC, Microsoft YaHei, sans-serif', overflow: 'hidden' }}>

  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 56, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>双人对话播客自动生成系统</Text>
    <Text style={{ fontSize: 15, color: '#BFD3EE' }}>D14 项目答辩</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 80, left: 40, width: 1200, flexDirection: 'column' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0E3F8C' }}>一句话形态与工程量</Text>
    <Box style={{ width: 88, height: 3, background: '#3D7BD9', marginTop: 12 }} />
  </Box>

  {/* 左 65%：形态示意（L1 主视觉） */}
  <Box style={{ position: 'absolute', top: 168, left: 40, width: 762, height: 486, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: '26px 28px', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
      <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>输入 —— 输出</Text>
      <Text style={{ fontSize: 15, color: '#8B97A8' }}>四项参数 → 三件交付物</Text>
    </Box>

    <svg width={706} height={196} viewBox='0 0 706 196'>
      {/* 输入块 */}
      <rect x='0' y='28' width='176' height='140' rx='6' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='1.5' />
      <text x='88' y='56' textAnchor='middle' fontSize='15' fontWeight='bold' fill='#0E3F8C'>输入（4 项）</text>
      <text x='88' y='84' textAnchor='middle' fontSize='14' fill='#1A2230'>主题</text>
      <text x='88' y='108' textAnchor='middle' fontSize='14' fill='#1A2230'>目标时长</text>
      <text x='88' y='132' textAnchor='middle' fontSize='14' fill='#1A2230'>语速</text>
      <text x='88' y='156' textAnchor='middle' fontSize='14' fill='#1A2230'>语言风格（可选）</text>

      {/* 箭头 */}
      <path d='M182 98 L236 98' stroke='#1E4FA8' strokeWidth='2.5' />
      <path d='M230 90 L242 98 L230 106 Z' fill='#1E4FA8' />

      {/* 引擎块 */}
      <rect x='248' y='48' width='150' height='100' rx='6' fill='#0E3F8C' />
      <text x='323' y='80' textAnchor='middle' fontSize='15' fontWeight='bold' fill='#FFFFFF'>生成引擎</text>
      <text x='323' y='104' textAnchor='middle' fontSize='13' fill='#A9C6EC'>DeepSeek 脚本</text>
      <text x='323' y='124' textAnchor='middle' fontSize='13' fill='#A9C6EC'>CosyVoice 双音色</text>

      {/* 箭头 */}
      <path d='M404 98 L458 98' stroke='#1E4FA8' strokeWidth='2.5' />
      <path d='M452 90 L464 98 L452 106 Z' fill='#1E4FA8' />

      {/* 输出块 */}
      <rect x='470' y='28' width='236' height='140' rx='6' fill='#FFFFFF' stroke='#3D7BD9' strokeWidth='1.5' />
      <text x='588' y='56' textAnchor='middle' fontSize='15' fontWeight='bold' fill='#0E3F8C'>输出（3 件）</text>
      <text x='588' y='84' textAnchor='middle' fontSize='14' fill='#1A2230'>双人对话脚本（可编辑）</text>
      <text x='588' y='108' textAnchor='middle' fontSize='14' fill='#1A2230'>成片 mp3（含片头片尾）</text>
      <text x='588' y='132' textAnchor='middle' fontSize='14' fill='#1A2230'>RSS 订阅源（可发布）</text>
      <text x='588' y='156' textAnchor='middle' fontSize='13' fill='#8B97A8'>三者均由同一次任务产生</text>
    </svg>

    <Box style={{ background: '#F0F5FC', borderLeft: '4px solid #1E4FA8', borderRadius: 4, padding: '14px 18px' }}>
      <Text style={{ fontSize: 19, color: '#1A2230', lineHeight: 1.62 }}>
        <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>判断　</span>
        真正的门槛不是"能生成一段音频"，而是让脚本、音频、订阅源三者出自同一条可追溯、可中断续跑的链路——这一条决定了后面所有工程决策。
      </Text>
    </Box>
  </Box>

  {/* 右 35%：工程量四数 */}
  <Box style={{ position: 'absolute', top: 168, left: 822, width: 418, height: 486, flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box style={{ height: 112, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: '18px 22px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
      <Text style={{ fontSize: 19, color: '#4A5568' }}>后端 API 端点</Text>
      <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>21</Text>
    </Box>
    <Box style={{ height: 112, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: '18px 22px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
      <Text style={{ fontSize: 19, color: '#4A5568' }}>前端页面</Text>
      <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>5</Text>
    </Box>
    <Box style={{ height: 112, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: '18px 22px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
      <Text style={{ fontSize: 19, color: '#4A5568' }}>数据表</Text>
      <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>6</Text>
    </Box>
    <Box style={{ height: 112, background: '#0E3F8C', borderRadius: 6, padding: '18px 22px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
      <Text style={{ fontSize: 19, color: '#D6E4F7' }}>交付文档</Text>
      <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1 }}>22</Text>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', top: 668, left: 40, width: 1200, height: 32, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>双人对话播客自动生成系统 · D14 答辩</Text>
    <Text style={{ fontSize: 16, color: '#1E4FA8', fontWeight: 'bold' }}>04 / 12</Text>
  </Box>

