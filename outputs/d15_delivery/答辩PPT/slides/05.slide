<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '20px 72px 20px 72px', flexDirection: 'column', fontFamily: '"Source Han Sans SC","Noto Sans SC","PingFang SC","Microsoft YaHei",sans-serif' }} notes={`这一页讲清楚它到底怎么来的。

左边是全部链路。你要填的只有四个框：主题、想听多久、语速、语言风格。填完之后，DeepSeek 先写一版双人对话脚本，CosyVoice 用你自己录的两段声音把脚本念出来，FFmpeg 做后期和响度归一，最后导出 mp3、写一条订阅源。你拿到的就是一个能订阅的播客频道。

右边是这三期演示的台账：三百零二秒、二百五十七秒、二百七十九秒，加起来十三分五十八秒、十二点七八兆、一百七十九行对话。这些数字是我当场从数据库里查出来的。台账本身只记「哪三期」，具体数字一律现测——写死在清单里的数字，迟早会和实物对不上。`}>

    {/* A · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#15171B', lineHeight: 1.25 }}>四个参数进去，一期播客出来</Text>
            <Text style={{ fontSize: 13, color: '#6E7480', fontFamily: '"JetBrains Mono","Cascadia Mono",Consolas,monospace', lineHeight: 1.4 }}>01 做出来的是什么</Text>
        </Box>
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 14, color: '#6E7480', lineHeight: 1.5 }}>
                二期的时长单位是秒，由 ffprobe 与数据库当场核对
            </Text>
            <Box style={{ height: 10 }} />
            <Box style={{ height: 1, background: '#15171B', opacity: 0.12 }} />
        </Box>
    </Box>

    {/* B · 内容区 */}
    <Box style={{ height: 540, flexDirection: 'row', paddingTop: 30, paddingBottom: 26 }}>

        {/* 左栏：链路 */}
        <Box style={{ width: 660, flexDirection: 'column', justifyContent: 'center', paddingRight: 44 }}>

            <Text style={{ fontSize: 13, color: '#6E7480', fontFamily: '"JetBrains Mono","Cascadia Mono",Consolas,monospace' }}>输入 —— 你只填这四个</Text>
            <Box style={{ height: 12 }} />
            <Box style={{ flexDirection: 'row', gap: 12 }}>
                <Box style={{ flex: 1, height: 54, background: '#15171B', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>主题</Text>
                </Box>
                <Box style={{ flex: 1, height: 54, background: '#15171B', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>目标时长</Text>
                </Box>
                <Box style={{ flex: 1, height: 54, background: '#15171B', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>语速</Text>
                </Box>
                <Box style={{ flex: 1, height: 54, background: '#15171B', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>语言风格</Text>
                </Box>
            </Box>

            <Box style={{ height: 16 }} />
            <Text style={{ fontSize: 15, color: '#D9480F', textAlign: 'center' }}>↓</Text>
            <Box style={{ height: 16 }} />

            <Text style={{ fontSize: 13, color: '#6E7480', fontFamily: '"JetBrains Mono","Cascadia Mono",Consolas,monospace' }}>自动处理 —— 五个阶段接力</Text>
            <Box style={{ height: 12 }} />
            <Box style={{ flexDirection: 'row', gap: 10 }}>
                <Box style={{ flex: 1, height: 62, background: '#EEF0F3', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#15171B' }}>写脚本</Text>
                    <Text style={{ fontSize: 12, color: '#5A6069', marginTop: 4 }}>DeepSeek</Text>
                </Box>
                <Box style={{ flex: 1, height: 62, background: '#EEF0F3', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#15171B' }}>等你确认</Text>
                    <Text style={{ fontSize: 12, color: '#5A6069', marginTop: 4 }}>可改可退</Text>
                </Box>
                <Box style={{ flex: 1, height: 62, background: '#EEF0F3', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#15171B' }}>念出来</Text>
                    <Text style={{ fontSize: 12, color: '#5A6069', marginTop: 4 }}>CosyVoice</Text>
                </Box>
                <Box style={{ flex: 1, height: 62, background: '#EEF0F3', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#15171B' }}>后期</Text>
                    <Text style={{ fontSize: 12, color: '#5A6069', marginTop: 4 }}>FFmpeg</Text>
                </Box>
                <Box style={{ flex: 1, height: 62, background: '#EEF0F3', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#15171B' }}>打包</Text>
                    <Text style={{ fontSize: 12, color: '#5A6069', marginTop: 4 }}>RSS</Text>
                </Box>
            </Box>

            <Box style={{ height: 16 }} />
            <Text style={{ fontSize: 15, color: '#D9480F', textAlign: 'center' }}>↓</Text>
            <Box style={{ height: 16 }} />

            <Text style={{ fontSize: 13, color: '#6E7480', fontFamily: '"JetBrains Mono","Cascadia Mono",Consolas,monospace' }}>输出 —— 三样东西</Text>
            <Box style={{ height: 12 }} />
            <Box style={{ flexDirection: 'row', gap: 12 }}>
                <Box style={{ flex: 1, height: 62, border: '1px solid #15171B', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#15171B' }}>双人对话脚本</Text>
                </Box>
                <Box style={{ flex: 1, height: 62, background: '#D9480F', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>成片 mp3</Text>
                </Box>
                <Box style={{ flex: 1, height: 62, border: '1px solid #15171B', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#15171B' }}>播客订阅源</Text>
                </Box>
            </Box>

        </Box>

        {/* 右栏：台账 */}
        <Box style={{ flex: 1, flexDirection: 'column', paddingTop: 4 }}>

            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#15171B', lineHeight: 1.35 }}>三期演示成片</Text>
            <Box style={{ height: 8 }} />
            <Text style={{ fontSize: 14, color: '#6E7480', lineHeight: 1.5 }}>
                清单只声明「哪三期」，数字一律现测
            </Text>
            <Box style={{ height: 18 }} />
            <Box style={{ height: 1, background: '#15171B', opacity: 0.14 }} />

            <Box style={{ height: 16 }} />
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#15171B', lineHeight: 1.4 }}>人工智能会不会取代程序员</Text>
            <Box style={{ height: 5 }} />
            <Text style={{ fontSize: 15, color: '#4B5158', fontFamily: '"JetBrains Mono","Cascadia Mono",Consolas,monospace' }}>302 s · 4.60 MB · 74 行</Text>

            <Box style={{ height: 22 }} />
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#15171B', lineHeight: 1.4 }}>为什么周末休息完反而更累</Text>
            <Box style={{ height: 5 }} />
            <Text style={{ fontSize: 15, color: '#4B5158', fontFamily: '"JetBrains Mono","Cascadia Mono",Consolas,monospace' }}>257 s · 3.92 MB · 47 行</Text>

            <Box style={{ height: 22 }} />
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#15171B', lineHeight: 1.4 }}>小城市正在变成新的机会洼地吗</Text>
            <Box style={{ height: 5 }} />
            <Text style={{ fontSize: 15, color: '#4B5158', fontFamily: '"JetBrains Mono","Cascadia Mono",Consolas,monospace' }}>279 s · 4.26 MB · 58 行</Text>

            <Box style={{ height: 18 }} />
            <Box style={{ height: 1, background: '#15171B', opacity: 0.14 }} />
            <Box style={{ height: 14 }} />
            <Text style={{ fontSize: 15, color: '#15171B', fontFamily: '"JetBrains Mono","Cascadia Mono",Consolas,monospace' }}>合计 838 s · 12.78 MB · 179 行</Text>

            <Box style={{ height: 22 }} />
            <Box style={{ borderLeft: '2px solid #D9480F', paddingLeft: 14 }}>
                <Text style={{ fontSize: 17, color: '#15171B', lineHeight: 1.6 }}>
                    这三期不是样例图，是机器跑出来的 —— 每一期都能现在点开听。
                </Text>
            </Box>

        </Box>

    </Box>

    {/* C · 页脚条 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 18, height: 2, background: '#D9480F' }} />
            <Text style={{ fontSize: 13, color: '#6E7480', lineHeight: 1.4 }}>双人对话播客自动生成系统 · 项目答辩</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#6E7480', fontFamily: '"JetBrains Mono","Cascadia Mono",Consolas,monospace', lineHeight: 1.4 }}>05 / 17</Text>
    </Box>

</Slide>
